FROM jupyter/minimal-notebook:latest

# Switch to root to install packages
USER root

# Install git and build tools (needed for pip install from GitHub and compiling dependencies)
RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Switch back to jovyan user
USER jovyan

# Install essential Python data science libraries (minimal set)
RUN pip install --no-cache-dir \
    eloy \
    cabaret \
    numpy \
    matplotlib \
    tqdm  \
    jupyter \
    ipywidgets

# Node.js is required to build the FITS viewer labextension
RUN mamba install -y -c conda-forge nodejs && mamba clean -afy

# Install the FITS viewer (file-browser labextension + inline `show()` helper).
# `pip install` triggers the JupyterLab build via hatch-jupyter-builder and
# auto-enables the bundled Jupyter Server extension.
COPY --chown=jovyan:users ./fits-lab-extension /tmp/fits-lab-extension
RUN pip install --no-cache-dir /tmp/fits-lab-extension \
    && jupyter labextension list \
    && jupyter server extension list

COPY ./notebooks /tmp_notebooks

# Ensure the notebook server starts in the correct directory
WORKDIR /home/jovyan
